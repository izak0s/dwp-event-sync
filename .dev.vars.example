# Copy to .dev.vars.staging / .dev.vars.prod (gitignored). `npm run dev` reads .dev.vars.staging.
# Deployed Workers get the same keys via .secrets.<env>.json + `npm run secrets:<env>`.
# Non-secret vars (WP_BASE_URL, WP_POST_STATUS, SITE_TIMEZONE) live in wrangler.jsonc.

# WordPress user + Application Password (Users -> Profile -> Application Passwords)
WP_USERNAME=
WP_APP_PASSWORD=

# Spacebring -> Network Settings -> Developers
SPACEBRING_CLIENT_ID=
SPACEBRING_CLIENT_SECRET=

# Spacebring location id (organization id in the app URL)
SPACEBRING_LOCATION_REF=

# Public event URL prefix; the event id is appended
SPACEBRING_EVENT_URL_BASE=https://app.example.spacebring.com/suite/organizations/<location-id>/events

# Spacebring -> Network Settings -> Developers -> Webhooks -> endpoint signing secret (whsec_...)
SPACEBRING_WEBHOOK_SECRET=
